# Environment template for the opencode server process (not this proxy app).
# Copy into the environment where opencode itself runs.
#
# Example:
#   cp .env.opencode.example /path/to/opencode/.env
#   # fill keys, then restart opencode server
#
# Tip: You can also inspect required env vars per provider from a running server:
#   GET /config/providers  -> providers[].env

#############################
# OpenCode server auth (optional but recommended)
#############################

OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode

#############################
# Common providers (pick one or more)
#############################

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
DEEPINFRA_API_KEY=

#############################
# OpenCode / Zen
#############################

OPENCODE_API_KEY=
ZENMUX_API_KEY=

#############################
# Google Vertex
#############################

GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

#############################
# Azure
#############################

# Provider: azure
AZURE_RESOURCE_NAME=
AZURE_API_KEY=

# Provider: azure-cognitive-services
AZURE_COGNITIVE_SERVICES_RESOURCE_NAME=
AZURE_COGNITIVE_SERVICES_API_KEY=

#############################
# Amazon Bedrock
#############################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_PROFILE=
AWS_BEARER_TOKEN_BEDROCK=
AWS_WEB_IDENTITY_TOKEN_FILE=

#############################
# Cloudflare
#############################

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_GATEWAY_ID=
CF_AIG_TOKEN=

#############################
# Other supported providers (optional)
#############################

GITLAB_TOKEN=
GITHUB_TOKEN=
OLLAMA_API_KEY=
V0_API_KEY=
SCALEWAY_API_KEY=
LLAMA_API_KEY=
POE_API_KEY=
AICORE_SERVICE_KEY=
AICORE_DEPLOYMENT_ID=
AICORE_RESOURCE_GROUP=
